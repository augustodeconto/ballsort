{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "BallSort (escolher cenário)",
            "request": "launch",
            "mainClass": "ballsort.BallSort",
            "args": ["${input:gameFile}"]
        }
    ],
    "inputs": [
        {
            "id": "gameFile",
